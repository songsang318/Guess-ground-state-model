import numpy as np
import matplotlib.pyplot as plt
from scipy.special import hermite
import math

# ==============================================================================
# 1. 물리 상수 및 기본 함수 정의
# ==============================================================================
m = 9.09e-31
hbar = 1.054e-34
omega = 1.0e15
hbar_omega = hbar * omega
decay_width = 3.405e-10
L = 1.0e-9
x_grid = np.linspace(-1.0e-9, 1.0e-9, 1000)

# 에너지 고윳값 수치 적분 계산 함수
def calculate_energy(psi_vals, x=x_grid):
    dx = x[1] - x[0]
    ddpsi = np.gradient(np.gradient(psi_vals, dx), dx)
    
    T_psi = -(hbar**2 / (2 * m)) * ddpsi
    V_psi = 0.5 * m * (omega**2) * (x**2) * psi_vals
    H_psi = T_psi + V_psi
    
    numerator = np.trapezoid(psi_vals * H_psi, x)
    denominator = np.trapezoid(psi_vals**2, x)
    
    if denominator < 1e-18:
        return 1e10
    return numerator / denominator

# 이론적 파동함수 생성 함수 (Hermite 다항식 기반)
def get_exact_wavefunction(n_state, x=x_grid):
    alpha = m * omega / hbar
    y = np.sqrt(alpha) * x
    norm_const = (alpha / np.pi)**0.25 / np.sqrt((2**n_state) * math.factorial(n_state))
    H_n = hermite(n_state)
    return norm_const * H_n(y) * np.exp(-0.5 * alpha * (x**2))

# ==============================================================================
# 2. 파동함수 생성 및 신경망 정의
# ==============================================================================
def create_psi(A, n_state, x=x_grid):
    A = np.array(A, dtype=float)
    envelope = np.exp(-0.5 * (x / decay_width)**2)
    fourier_sum = np.zeros_like(x, dtype=float)
    
    if n_state % 2 == 0:  # Even Parity (cos 기저)
        for k, coeff in enumerate(A):
            fourier_sum += coeff * np.cos((2 * k + 1) * np.pi * x / (2 * L))
    else:                 # Odd Parity (sin 기저)
        for k, coeff in enumerate(A):
            fourier_sum += coeff * np.sin((k + 1) * np.pi * x / L)
            
    return envelope * fourier_sum

class NNVM:
    def __init__(self, hidden_layers=[12, 12, 12, 12], output_dim=15, seed=42):
        if seed is not None:
            np.random.seed(seed)
        layer_sizes = [1] + hidden_layers + [output_dim]
        self.num_layers = len(layer_sizes) - 1
        self.weights = []
        self.biases = []
        
        for i in range(self.num_layers):
            in_dim = layer_sizes[i]
            out_dim = layer_sizes[i+1]
            limit = np.sqrt(6.0 / (in_dim + out_dim))
            W = np.random.uniform(-limit, limit, (in_dim, out_dim))
            b = np.zeros((1, out_dim))
            self.weights.append(W)
            self.biases.append(b)
            
        self.activations = []
        self.z_values = []

    def _act(self, z):
        return np.tanh(z)

    def _act_derivative(self, a):
        return 1.0 - a**2

    def forward(self, x=None):
        if x is None:
            x = np.array([[1.0]])
        self.activations = [x]
        self.z_values = []
        a = x
        for i in range(self.num_layers - 1):
            z = np.dot(a, self.weights[i]) + self.biases[i]
            a = self._act(z)
            self.z_values.append(z)
            self.activations.append(a)
            
        z_last = np.dot(a, self.weights[-1]) + self.biases[-1]
        self.z_values.append(z_last)
        self.activations.append(z_last)
        return z_last.flatten()

    def backward(self, loss_func, eps=1e-4):
        A = self.activations[-1].flatten().copy()
        num_outputs = len(A)
        dL_dout = np.zeros(num_outputs)
        
        for i in range(num_outputs):
            A_plus = A.copy()
            A_minus = A.copy()
            A_plus[i] += eps
            A_minus[i] -= eps
            
            E_plus = loss_func(A_plus)
            E_minus = loss_func(A_minus)
            dL_dout[i] = (E_plus - E_minus) / (2.0 * eps)
            
        delta = dL_dout.reshape(1, -1)
        grads_W = [None] * self.num_layers
        grads_b = [None] * self.num_layers
        
        for l in range(self.num_layers - 1, -1, -1):
            a_prev = self.activations[l]
            grads_W[l] = np.dot(a_prev.T, delta)
            grads_b[l] = delta
            if l > 0:
                delta = np.dot(delta, self.weights[l].T) * self._act_derivative(a_prev)
                
        return grads_W, grads_b

# ==============================================================================
# 3. 손실 함수 (에너지 최소화 + 이전 상태들과의 직교성 페널티)
# ==============================================================================
def compute_loss(A, n_target, prior_psis, lambda_ortho=15.0):
    psi_cand = create_psi(A, n_target)
    
    # 1. 정규화된 에너지 계산
    E = calculate_energy(psi_cand)
    loss = E / hbar_omega
    
    # 2. 이전 상태들과의 직교성 페널티
    norm_cand = np.sqrt(np.trapezoid(psi_cand**2, x_grid))
    if norm_cand > 1e-15:
        for psi_prev in prior_psis:
            norm_prev = np.sqrt(np.trapezoid(psi_prev**2, x_grid))
            if norm_prev > 1e-15:
                overlap = np.trapezoid(psi_prev * psi_cand, x_grid) / (norm_prev * norm_cand)
                loss += lambda_ortho * (overlap**2)
                
    return loss

# ==============================================================================
# 4. 사용자 입력 및 메인 실행 루프
# ==============================================================================
if __name__ == "__main__":
    print("=" * 60)
    print("   Harmonic Oscillator Wavefunction Guess via Neural Network")
    print("=" * 60)
    
    target_n = int(input("구하고자 하는 양자수 n을 입력하세요 (예: 0, 1, 2): "))
    out_dim = int(input("Output Vector 크기를 입력하세요 (추천: 15 ~ 25): "))
    epochs = int(input("학습 Epoch 수를 입력하세요 (추천: 1000 ~ 2000): "))
    lr = 0.005

    learned_states = []

    # 0번 바닥상태부터 target_n까지 순차적으로 학습
    for current_n in range(target_n + 1):
        print(f"\n[상태 n = {current_n} 학습 진행 중...]")
        model = NNVM(hidden_layers=[12, 12, 12, 12], output_dim=out_dim, seed=42 + current_n * 10)
        
        for epoch in range(epochs):
            A = model.forward()
            current_loss = compute_loss(A, current_n, learned_states)
            grads_W, grads_b = model.backward(lambda a: compute_loss(a, current_n, learned_states))
            
            for l in range(model.num_layers):
                model.weights[l] -= lr * grads_W[l]
                model.biases[l] -= lr * grads_b[l]
                
            if (epoch + 1) % max(1, (epochs // 5)) == 0 or epoch == 0:
                print(f"  Epoch [{epoch+1}/{epochs}] - Loss: {current_loss:.6f}")
                
        final_A = model.forward()
        best_psi = create_psi(final_A, current_n)
        learned_states.append(best_psi)

    # ==============================================================================
    # 5. 결과 검증, 오차율 계산 및 시각화
    # ==============================================================================
    target_psi_exact = get_exact_wavefunction(target_n)
    target_psi_pred = learned_states[target_n]

    # 정규화
    norm_exact = np.sqrt(np.trapezoid(target_psi_exact**2, x_grid))
    norm_pred = np.sqrt(np.trapezoid(target_psi_pred**2, x_grid))
    psi_exact_norm = target_psi_exact / norm_exact
    psi_pred_norm = target_psi_pred / norm_pred

    # 위상(부호) 일치 보정 (이론값과의 내적이 음수면 반전)
    if np.trapezoid(psi_exact_norm * psi_pred_norm, x_grid) < 0:
        psi_pred_norm = -psi_pred_norm

    exact_E = (target_n + 0.5) * hbar_omega
    pred_E = calculate_energy(psi_pred_norm)
    error_rate = abs(pred_E - exact_E) / exact_E * 100

    print("\n" + "=" * 60)
    print(f" [결과 요약 (n = {target_n})]")
    print(f" 이론적 에너지 고윳값 : {exact_E:.6e} J ({(exact_E / hbar_omega):.4f} ħω)")
    print(f" 추측된 에너지 고윳값 : {pred_E:.6e} J ({(pred_E / hbar_omega):.4f} ħω)")
    print(f" 에너지 상대 오차율   : {error_rate:.4f} %")
    print("=" * 60)

    # 시각화 플롯
    plt.figure(figsize=(10, 6))
    x_nm = x_grid * 1e9

    # 이전 상태들 궤적 표시
    for idx in range(target_n):
        p_norm = learned_states[idx] / np.sqrt(np.trapezoid(learned_states[idx]**2, x_grid))
        plt.plot(x_nm, p_norm, linestyle=':', color='gray', alpha=0.4, label=f'Learned n={idx}')

    plt.plot(x_nm, psi_exact_norm, label=f'Exact $\psi_{target_n}(x)$', color='black', linewidth=2.0, linestyle='--')
    plt.plot(x_nm, psi_pred_norm, label=f'NN Guessed $\psi_{target_n}(x)$', color='crimson', linewidth=1.8, alpha=0.85)
    plt.fill_between(x_nm, psi_exact_norm, psi_pred_norm, color='salmon', alpha=0.25, label='Difference')

    plt.title(f"Harmonic Oscillator $n = {target_n}$ Wavefunction Comparison", fontsize=14, pad=12)
    plt.xlabel("Position $x$ (nm)", fontsize=12)
    plt.ylabel("$\psi(x)$ ($\mathrm{m}^{-1/2}$)", fontsize=12)
    plt.axhline(0, color='black', linewidth=0.5, linestyle='-')
    plt.grid(True, linestyle=':', alpha=0.6)
    plt.legend(fontsize=10, loc='upper right')
    plt.xlim(-1.0, 1.0)
    plt.tight_layout()

    plt.show()